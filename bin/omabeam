#!/bin/bash
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
share="$here/../share"
[ -f "$share/omabeam-server.py" ] || share="/usr/share/omabeam"
sess="$HOME/.cache/omabeam/session"
port="${OMABEAM_PORT:-8899}"

ensure_input() {
  pgrep -x ydotoold >/dev/null 2>&1 || { ydotoold >/dev/null 2>&1 & disown; sleep 1; }
}

case "${1:-start}" in
  start)
    ensure_input
    exec python3 "$share/omabeam-server.py"
    ;;
  tunnel)
    command -v cloudflared >/dev/null || { echo "omabeam: cloudflared not installed" >&2; exit 1; }
    ensure_input
    python3 "$share/omabeam-server.py" >/dev/null 2>&1 &
    sleep 2
    tok="$(sed -n 2p "$sess")"
    cloudflared tunnel --url "http://localhost:$port" 2>&1 | while read -r line; do
      u="$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' <<<"$line" || true)"
      if [ -n "$u" ]; then
        echo "omabeam: open  $u/?t=$tok"
        command -v qrencode >/dev/null && qrencode -t ANSIUTF8 -m 2 "$u/?t=$tok"
      fi
    done
    ;;
  url)
    sed -n 1p "$sess" 2>/dev/null || true
    ;;
  *)
    echo "usage: omabeam [start|tunnel|url]" >&2
    exit 2
    ;;
esac
