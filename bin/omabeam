#!/bin/bash
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
share="$here/../share"
[ -f "$share/omabeam-server.py" ] || share="/usr/share/omabeam"
cache="$HOME/.cache/omabeam"; mkdir -p "$cache"
sess="$cache/session"; pub="$cache/public"
cfg="$HOME/.config/omabeam/config"
# Runtime commands read the saved config; setup/provision must not be shadowed by it.
case "${1:-anywhere}" in setup|provision) : ;; *) [ -f "$cfg" ] && . "$cfg" ;; esac
port="${OMABEAM_PORT:-8899}"
STARTED=0

ensure_input() { pgrep -x ydotoold >/dev/null 2>&1 || { ydotoold >/dev/null 2>&1 & disown; sleep 1; }; }
server_pid()   { ss -ltnp 2>/dev/null | grep ":$port " | grep -oP 'pid=\K[0-9]+' | head -1; }
token()        { sed -n 2p "$sess" 2>/dev/null; }
lan_url()      { sed -n 1p "$sess" 2>/dev/null; }
qr()           { command -v qrencode >/dev/null && qrencode -t ANSIUTF8 -m 2 "$1" || true; }
goarch()       { case "$(uname -m)" in x86_64) echo amd64;; aarch64|arm64) echo arm64;; *) echo amd64;; esac; }

ensure_cloudflared() {
  command -v cloudflared >/dev/null && { command -v cloudflared; return; }
  [ -x "$HOME/.local/bin/cloudflared" ] && { echo "$HOME/.local/bin/cloudflared"; return; }
  echo "omabeam: fetching cloudflared (one time)…" >&2
  mkdir -p "$HOME/.local/bin"
  curl -fsSL -o "$HOME/.local/bin/cloudflared" \
    "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$(goarch)" >&2 \
    || { echo "omabeam: could not download cloudflared." >&2; return 1; }
  chmod +x "$HOME/.local/bin/cloudflared"; echo "$HOME/.local/bin/cloudflared"
}
ensure_ngrok() {
  command -v ngrok >/dev/null && { command -v ngrok; return; }
  [ -x "$HOME/.local/bin/ngrok" ] && { echo "$HOME/.local/bin/ngrok"; return; }
  echo "omabeam: fetching ngrok (one time)…" >&2
  local t; t="$(mktemp)"
  curl -fsSL -o "$t" "https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-linux-$(goarch).tgz" >&2 \
    || { echo "omabeam: could not download ngrok." >&2; rm -f "$t"; return 1; }
  mkdir -p "$HOME/.local/bin"; tar -xzf "$t" -C "$HOME/.local/bin" ngrok 2>/dev/null; rm -f "$t"
  chmod +x "$HOME/.local/bin/ngrok"; echo "$HOME/.local/bin/ngrok"
}

start_server_bg() {
  ensure_input
  if [ -z "$(server_pid)" ]; then
    python3 "$share/omabeam-server.py" >/dev/null 2>&1 &
    STARTED=1; sleep 2
  fi
}
cleanup() { [ "$STARTED" = 1 ] && { p="$(server_pid)"; [ -n "${p:-}" ] && kill "$p" 2>/dev/null || true; }; }

anywhere() {
  rm -f "$pub"; start_server_bg; trap cleanup EXIT INT TERM
  echo "omabeam: on your network →  $(lan_url)"; echo
  local tok; tok="$(token)"

  # 1) Cloudflare named tunnel — permanent hostname you own
  local cft="${OMABEAM_TUNNEL_TOKEN:-${TUNNEL_TOKEN:-}}"
  if [ -n "$cft" ]; then
    local host="${OMABEAM_TUNNEL_HOSTNAME:-${TUNNEL_HOSTNAME:-}}"
    if [ -n "$host" ]; then
      printf 'https://%s/?t=%s\n' "$host" "$tok" > "$pub"
      echo "omabeam: permanent link →  https://$host/?t=$tok"; qr "https://$host/?t=$tok"
    else
      echo "omabeam: running your named tunnel (set TUNNEL_HOSTNAME in $cfg to print the link + QR)."
    fi
    exec "$(ensure_cloudflared)" tunnel run --token "$cft"
  fi

  # 2) ngrok reserved domain — free static URL
  local ngd="${OMABEAM_NGROK_DOMAIN:-${NGROK_DOMAIN:-}}"
  if [ -n "$ngd" ]; then
    local ng; ng="$(ensure_ngrok)" || exit 1
    printf 'https://%s/?t=%s\n' "$ngd" "$tok" > "$pub"
    echo "omabeam: permanent link →  https://$ngd/?t=$tok"; qr "https://$ngd/?t=$tok"
    exec "$ng" http --url="https://$ngd" "$port" --log=stderr
  fi

  # 3) quick tunnel — works anywhere, but the URL changes each run
  echo "Opening a temporary public link (token-protected). For a link that never"
  echo "changes, run:  omabeam setup"; echo
  local cf; cf="$(ensure_cloudflared)" || exit 1
  "$cf" tunnel --url "http://localhost:$port" 2>&1 | while read -r line; do
    u="$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' <<<"$line" || true)"
    if [ -n "$u" ]; then
      printf '%s/?t=%s\n' "$u" "$tok" > "$pub"
      echo "omabeam: reachable anywhere →  $u/?t=$tok"; qr "$u/?t=$tok"
      command -v notify-send >/dev/null && notify-send "omabeam" "Anywhere link ready" || true
    fi
  done
}

save_cfg() { mkdir -p "$(dirname "$cfg")"; { echo "# omabeam remote config"; printf '%s\n' "$@"; } > "$cfg"; }

# Fully automated Cloudflare tunnel from one API token — no dashboard, no prompts.
provision_cloudflare() {
  : "${CF_API_TOKEN:?set CF_API_TOKEN}"; : "${CF_ZONE:?set CF_ZONE (a domain on your Cloudflare account)}"
  local host="${CF_HOSTNAME:-beam.$CF_ZONE}" api="https://api.cloudflare.com/client/v4"
  local A=(-H "Authorization: Bearer $CF_API_TOKEN" -H "Content-Type: application/json")
  local acct zone tid tok sec
  acct="$(curl -fsS "${A[@]}" "$api/accounts" | jq -r '.result[0].id // empty')"
  zone="$(curl -fsS "${A[@]}" "$api/zones?name=$CF_ZONE" | jq -r '.result[0].id // empty')"
  [ -n "$acct" ] && [ -n "$zone" ] || { echo "omabeam: API token can't see your account/zone ($CF_ZONE)." >&2; return 1; }
  sec="$(python3 -c 'import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())')"
  tid="$(curl -fsS "${A[@]}" -X POST "$api/accounts/$acct/cfd_tunnel" \
        --data "{\"name\":\"omabeam\",\"tunnel_secret\":\"$sec\",\"config_src\":\"cloudflare\"}" | jq -r '.result.id // empty')"
  [ -n "$tid" ] || { echo "omabeam: tunnel create failed." >&2; return 1; }
  tok="$(curl -fsS "${A[@]}" "$api/accounts/$acct/cfd_tunnel/$tid/token" | jq -r '.result // empty')"
  curl -fsS "${A[@]}" -X PUT "$api/accounts/$acct/cfd_tunnel/$tid/configurations" \
    --data "{\"config\":{\"ingress\":[{\"hostname\":\"$host\",\"service\":\"http://localhost:$port\"},{\"service\":\"http_status:404\"}]}}" >/dev/null
  curl -fsS "${A[@]}" -X POST "$api/zones/$zone/dns_records" \
    --data "{\"type\":\"CNAME\",\"name\":\"$host\",\"content\":\"$tid.cfargotunnel.com\",\"proxied\":true}" >/dev/null
  save_cfg "$(printf 'TUNNEL_TOKEN=%q' "$tok")" "$(printf 'TUNNEL_HOSTNAME=%q' "$host")"
  echo "omabeam: provisioned. Permanent link → https://$host/?t=$(token). Run 'omabeam'."
}

setup() {
  # Non-interactive when credentials are supplied — agent- and script-drivable.
  if [ -n "${CF_API_TOKEN:-}" ] && [ -n "${CF_ZONE:-}" ]; then provision_cloudflare; return; fi
  if [ -n "${TUNNEL_TOKEN:-${OMABEAM_TUNNEL_TOKEN:-}}" ]; then
    save_cfg "$(printf 'TUNNEL_TOKEN=%q' "${TUNNEL_TOKEN:-$OMABEAM_TUNNEL_TOKEN}")" \
             ${TUNNEL_HOSTNAME:+"$(printf 'TUNNEL_HOSTNAME=%q' "$TUNNEL_HOSTNAME")"}
    echo "omabeam: Cloudflare named tunnel configured."; return
  fi
  if [ -n "${NGROK_AUTHTOKEN:-}" ]; then
    "$(ensure_ngrok)" config add-authtoken "$NGROK_AUTHTOKEN" >/dev/null
    save_cfg ${NGROK_DOMAIN:+"$(printf 'NGROK_DOMAIN=%q' "$NGROK_DOMAIN")"}
    echo "omabeam: ngrok configured${NGROK_DOMAIN:+ — permanent link https://$NGROK_DOMAIN/?t=$(token)}."
    return
  fi
  if [ ! -t 0 ]; then
    cat <<EOF
omabeam setup needs credentials once (accounts can't be created headless). Then
everything is automatic — no dashboard, no prompts. Pick one:

  # Cloudflare: from ONE API token, omabeam creates the tunnel + DNS for you.
  CF_API_TOKEN=... CF_ZONE=yourdomain.com [CF_HOSTNAME=beam.yourdomain.com] omabeam setup

  # ngrok: paste an authtoken (+ your reserved free domain)
  NGROK_AUTHTOKEN=... NGROK_DOMAIN=name.ngrok-free.app omabeam setup

  # Or a tunnel token you already have
  TUNNEL_TOKEN=... TUNNEL_HOSTNAME=beam.yourdomain.com omabeam setup
EOF
    return
  fi
  # Interactive fallback.
  echo "omabeam setup — a permanent link that never changes."
  echo "  1) Cloudflare (automatic, needs an API token + a domain on Cloudflare)"
  echo "  2) ngrok (free reserved domain)"
  read -rp "Choose 1 or 2: " choice
  case "$choice" in
    1) read -rp "Cloudflare API token: " CF_API_TOKEN; read -rp "Your domain (zone): " CF_ZONE
       read -rp "Hostname [beam.$CF_ZONE]: " CF_HOSTNAME; export CF_API_TOKEN CF_ZONE CF_HOSTNAME
       provision_cloudflare ;;
    2) local ng; ng="$(ensure_ngrok)" || exit 1
       echo "Sign in free at https://dashboard.ngrok.com, then paste your authtoken."
       read -rp "authtoken: " tk; "$ng" config add-authtoken "$tk" >/dev/null
       echo "Claim your free domain at https://dashboard.ngrok.com/domains."
       read -rp "domain (name.ngrok-free.app): " dom
       save_cfg "$(printf 'NGROK_DOMAIN=%q' "$dom")"
       echo "Done. Permanent link → https://$dom/?t=$(token)" ;;
    *) echo "omabeam: nothing chosen."; exit 1 ;;
  esac
}

case "${1:-anywhere}" in
  anywhere) anywhere ;;
  setup)    setup ;;
  provision) provision_cloudflare ;;
  lan)
    ensure_input
    pid="$(server_pid)"; [ -n "${pid:-}" ] && { kill "$pid" 2>/dev/null || true; sleep 1; }
    rm -f "$pub"
    echo "omabeam: local only — reachable on your network, never the internet."
    exec python3 "$share/omabeam-server.py"
    ;;
  rotate)
    printf 'omabeam\n%s\n' "$(python3 -c 'import secrets;print(secrets.token_urlsafe(16))')" > "$sess"
    chmod 600 "$sess"; rm -f "$pub"
    pid="$(server_pid)"; [ -n "${pid:-}" ] && { kill "$pid" 2>/dev/null || true; sleep 1; }
    echo "omabeam: token rotated — every old link is dead. Run 'omabeam' for a fresh one."
    ;;
  stop)
    pid="$(server_pid)"; [ -n "${pid:-}" ] && { kill "$pid"; echo "omabeam: stopped."; } || echo "omabeam: not running."
    rm -f "$pub"
    ;;
  url) [ -f "$pub" ] && cat "$pub" || lan_url ;;
  qr)  u="$([ -f "$pub" ] && cat "$pub" || lan_url)"; [ -n "$u" ] && { echo "$u"; qr "$u"; } || echo "omabeam: not running." ;;
  doctor)
    ok()  { printf '  \033[32m✓\033[0m %s\n' "$1"; }
    bad() { printf '  \033[31m✗\033[0m %s\n' "$1"; }
    echo "omabeam doctor — readiness check"
    for c in hyprctl grim wtype ydotool jq; do
      command -v "$c" >/dev/null && ok "$c" || bad "$c is missing (install it)"
    done
    pgrep -x ydotoold >/dev/null 2>&1 && ok "ydotoold running" || bad "ydotoold not running (omabeam starts it automatically)"
    if [ -e /dev/uinput ]; then
      [ -w /dev/uinput ] && ok "/dev/uinput writable" || bad "/dev/uinput not writable — add the udev rule (see install-omarchy)"
    else
      bad "/dev/uinput missing — run: sudo modprobe uinput"
    fi
    id -nG 2>/dev/null | tr ' ' '\n' | grep -qx input && ok "user in 'input' group" \
      || bad "not in 'input' group — sudo usermod -aG input \"$USER\", then log out and back in"
    if [ "$(hyprctl dispatch 'hl.dsp.exec_cmd("true")' 2>/dev/null)" = ok ]; then
      ok "compositor dispatch: lua (hl.dsp)"
    else
      ok "compositor dispatch: classic hyprctl"
    fi
    n="$(hyprctl monitors -j 2>/dev/null | jq 'length' 2>/dev/null || echo 1)"
    [ "${n:-1}" -gt 1 ] && bad "multi-monitor ($n) — omabeam targets the primary only for now" || ok "single monitor"
    for c in cloudflared qrencode omaspaces; do
      { command -v "$c" >/dev/null || [ -x "$HOME/.local/bin/$c" ]; } && ok "$c (optional)" || echo "  · $c (optional) not installed"
    done
    ;;
  -h|--help|help)
    cat <<USAGE
omabeam — your Omarchy desktop, on your phone (from anywhere)

  omabeam            start and print a secure link that works anywhere (+ QR)
  omabeam setup      configure a PERMANENT link that never changes (ngrok / Cloudflare)
  omabeam qr         reprint the current link + QR
  omabeam url        print the current link
  omabeam lan        local network only (no public link)
  omabeam rotate     revoke the current link (new token) and restart fresh
  omabeam stop       stop the server
  omabeam doctor     check dependencies + input + compositor readiness

Without setup, each run gets a fresh temporary URL. After 'omabeam setup' the
link is permanent — bookmark it once. The link carries a token; treat it like a
password, and 'omabeam rotate' revokes it.
USAGE
    ;;
  *) echo "omabeam: unknown command '$1' (try 'omabeam --help')" >&2; exit 2 ;;
esac
